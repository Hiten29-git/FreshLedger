{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile and global notification delivery settings.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "maxLength": 200
        },
        "browserPushEnabled": {
          "type": "boolean"
        },
        "dailyCheckHour": {
          "type": "integer"
        },
        "currencyCode": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "minLength": 3,
          "maxLength": 3
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "displayName",
        "email",
        "browserPushEnabled",
        "dailyCheckHour",
        "createdAt",
        "updatedAt"
      ]
    },
    "FoodItem": {
      "title": "FoodItem",
      "description": "Tracked food item in pantry, refrigerator, or freezer inventory.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "enum": [
            "Produce",
            "Dairy",
            "Meat & Seafood",
            "Bakery",
            "Pantry",
            "Frozen",
            "Beverages",
            "Prepared"
          ],
          "maxLength": 40
        },
        "storageLocation": {
          "type": "string",
          "enum": [
            "Refrigerator",
            "Freezer",
            "Pantry",
            "Counter"
          ],
          "maxLength": 30
        },
        "quantity": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "enum": [
            "pcs",
            "kg",
            "g",
            "L",
            "ml",
            "packs",
            "oz",
            "lbs"
          ],
          "maxLength": 16
        },
        "estimatedCost": {
          "type": "number"
        },
        "purchasedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "maxLength": 10
        },
        "expiresAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "maxLength": 10
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "consumed",
            "wasted"
          ],
          "maxLength": 16
        },
        "notifiedTiers": {
          "type": "array",
          "description": "Bounded list of notification tier keys already triggered for this item."
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "name",
        "category",
        "storageLocation",
        "quantity",
        "unit",
        "estimatedCost",
        "purchasedAt",
        "expiresAt",
        "status",
        "notifiedTiers",
        "notes",
        "createdAt",
        "updatedAt"
      ]
    },
    "NotificationRule": {
      "title": "NotificationRule",
      "description": "Automated pre-expiration notification lead-time rule.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "tierKey": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 32
        },
        "daysBefore": {
          "type": "integer"
        },
        "ruleType": {
          "type": "string",
          "enum": [
            "expiry",
            "stock"
          ],
          "maxLength": 16
        },
        "minQuantity": {
          "type": "number"
        },
        "targetUnit": {
          "type": "string",
          "enum": [
            "ANY",
            "pcs",
            "kg",
            "g",
            "L",
            "ml",
            "packs",
            "oz",
            "lbs"
          ],
          "maxLength": 16
        },
        "targetCategory": {
          "type": "string",
          "enum": [
            "ALL",
            "Produce",
            "Dairy",
            "Meat & Seafood",
            "Bakery",
            "Pantry",
            "Frozen",
            "Beverages",
            "Prepared"
          ],
          "maxLength": 40
        },
        "enabled": {
          "type": "boolean"
        },
        "channelBrowser": {
          "type": "boolean"
        },
        "channelInApp": {
          "type": "boolean"
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "urgent",
            "expired"
          ],
          "maxLength": 16
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "label",
        "tierKey",
        "daysBefore",
        "enabled",
        "channelBrowser",
        "channelInApp",
        "severity",
        "createdAt",
        "updatedAt"
      ]
    },
    "ExpiryNotification": {
      "title": "ExpiryNotification",
      "description": "Automated pre-expiration or expiration alert record.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "itemId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "itemName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "tierKey": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 32
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "urgent",
            "expired"
          ],
          "maxLength": 16
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "expiresAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "maxLength": 10
        },
        "daysRemaining": {
          "type": "integer"
        },
        "read": {
          "type": "boolean"
        },
        "dismissed": {
          "type": "boolean"
        },
        "deliveredBrowser": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "itemId",
        "itemName",
        "tierKey",
        "severity",
        "title",
        "message",
        "expiresAt",
        "daysRemaining",
        "read",
        "dismissed",
        "deliveredBrowser",
        "createdAt",
        "updatedAt"
      ]
    },
    "WasteLog": {
      "title": "WasteLog",
      "description": "Immutable outcome record when a food item is consumed or wasted.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "itemId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "itemName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "enum": [
            "Produce",
            "Dairy",
            "Meat & Seafood",
            "Bakery",
            "Pantry",
            "Frozen",
            "Beverages",
            "Prepared"
          ],
          "maxLength": 40
        },
        "outcome": {
          "type": "string",
          "enum": [
            "consumed",
            "wasted"
          ],
          "maxLength": 16
        },
        "quantity": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "enum": [
            "pcs",
            "kg",
            "g",
            "L",
            "ml",
            "packs",
            "oz",
            "lbs"
          ],
          "maxLength": 16
        },
        "estimatedValue": {
          "type": "number"
        },
        "reason": {
          "type": "string",
          "enum": [
            "Used in Time",
            "Expired",
            "Spoiled Early",
            "Over-purchased",
            "Leftovers",
            "Other"
          ],
          "maxLength": 32
        },
        "loggedDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "maxLength": 10
        },
        "notes": {
          "type": "string",
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "itemId",
        "itemName",
        "category",
        "outcome",
        "quantity",
        "unit",
        "estimatedValue",
        "reason",
        "loggedDate",
        "notes",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Private user profile and notification settings."
    },
    "/users/{userId}/items/{itemId}": {
      "schema": {
        "$ref": "#/entities/FoodItem"
      },
      "description": "User food inventory items with expiration dates and notification tier tracking."
    },
    "/users/{userId}/rules/{ruleId}": {
      "schema": {
        "$ref": "#/entities/NotificationRule"
      },
      "description": "Configurable automated pre-expiration alert rules."
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": {
        "$ref": "#/entities/ExpiryNotification"
      },
      "description": "Dispatched pre-expiration and expiration alerts."
    },
    "/users/{userId}/wasteLogs/{logId}": {
      "schema": {
        "$ref": "#/entities/WasteLog"
      },
      "description": "Historical consumed and wasted item logs for analytics."
    }
  }
}
